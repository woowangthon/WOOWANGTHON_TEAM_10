# 이 파일은 "어떤 설정이 필요한지"만 알려주는 견본입니다. 실제 값은 넣지 마세요.
# 실제 값은 로컬의 .env.local(커밋 안 됨) 또는 Vercel 프로젝트 설정의 Environment Variables에 넣습니다.
# NEXT_PUBLIC_ 으로 시작하는 변수는 브라우저에 공개되므로 비밀값을 절대 넣지 않습니다.

# 로그인 세션 서명 키: 32자 이상 무작위 문자열 (예: openssl rand -base64 36)
SESSION_SECRET=
# AI 제공자: none(기본, AI 미연결) | fake(개발용 가짜 응답, 운영 환경에서는 거부됨) | claude(다음 단계)
AI_PROVIDER=none
# 모델 호출 시간 제한(밀리초, 1000~120000)
AI_TIMEOUT_MS=30000
ANTHROPIC_API_KEY=
EMBEDDING_API_KEY=
# PostgreSQL 접속 주소 (Supabase·Neon 등 어디든 가능, pg_trgm 확장 필요)
DATABASE_URL=
